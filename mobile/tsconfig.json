{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "types": [
      "node"
    ]
  },
  "include": [
    "api/**/*.ts",
    "ops/**/*.ts",
    "ops/**/*.js"
  ],
  "extends": "expo/tsconfig.base"
}
