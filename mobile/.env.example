# --- Domana (mobile) env example ---
# EAS channel (dev | staging | prod)
EAS_CHANNEL=dev

# Public runtime vars (readable in app via process.env)
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
EXPO_PUBLIC_SENTRY_DSN=

# Store-submission versioning overrides (optional; else derived from version)
ANDROID_VERSION_CODE=1
IOS_BUILD_NUMBER=1
# Google Maps (Android)
EXPO_PUBLIC_ANDROID_GOOGLE_MAPS_API_KEY=
