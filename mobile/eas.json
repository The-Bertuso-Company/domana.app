{
  "cli": {
    "version": "\u003e= 8.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "channel": "dev",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EAS_CHANNEL": "dev"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "staging": {
      "channel": "staging",
      "distribution": "internal",
      "env": {
        "EAS_CHANNEL": "staging"
      }
    },
    "production": {
      "channel": "prod",
      "env": {
        "EAS_CHANNEL": "prod"
      }
    }
  },
  "submit": {
    "staging": {
      "android": {
        "track": "internal"
      }
    },
    "production": {
      "android": {
        "track": "production"
      }
    }
  }
}
