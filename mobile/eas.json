{
    "cli":  {
                "version":  "\u003e=16.20.0"
            },
    "build":  {
                  "dev":  {
                              "developmentClient":  true,
                              "channel":  "dev",
                              "env":  {
                                          "APP_STAGE":  "DEV"
                                      },
                              "autoIncrement":  true
                          },
                  "preview":  {
                                  "channel":  "staging",
                                  "env":  {
                                              "APP_STAGE":  "STAGING"
                                          },
                                  "android":  {
                                                  "buildType":  "apk"
                                              },
                                  "autoIncrement":  true
                              },
                  "production":  {
                                     "channel":  "prod",
                                     "env":  {
                                                 "APP_STAGE":  "PROD"
                                             },
                                     "android":  {
                                                     "buildType":  "app-bundle"
                                                 },
                                     "autoIncrement":  true
                                 }
              },
    "submit":  {
                   "preview":  {
                                   "android":  {
                                                   "track":  "internal"
                                               }
                               },
                   "production":  {
                                      "android":  {
                                                      "track":  "production"
                                                  }
                                  }
               }
}
