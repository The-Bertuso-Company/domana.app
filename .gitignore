# Dependencies
node_modules/

# Environment variables (never commit secrets)
.env
.env.*
!.env.example  # keep a template for local dev

# OS / editor junk
.DS_Store
Thumbs.db

# Build outputs
dist/
.next/
out/            # Next.js static export (if used)
coverage/       # test coverage

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vercel deployment
.vercel/

# Local tooling / IDE
.vscode/
*.swp
# build + deps
.next/
frontend/.next/
node_modules/
frontend/node_modules/

# backups & archives
backups/
frontend/backups/
*.zip

# Expo / React Native
.expo/
.expo-shared/
web-build/

# Local env (never commit real secrets)
.env
.env.*
!.env.example  # template is safe to keep


# backup/disabled files
**/*.bak
**/*.disabled
**/*.backup.json
**/*.corrupt.bak


# env/secrets
env.local
.npmrc


## allow env examples
!**/.env.example
!**/.env.*.example
