# ==========================
# 🧱 Dependencies
# ==========================
node_modules/
frontend/node_modules/

# ==========================
# 🔐 Environment variables (never commit secrets)
# ==========================
.env
.env.*
!.env.template   # keep the safe example template

# ==========================
# 💻 OS / Editor junk
# ==========================
.DS_Store
Thumbs.db
.vscode/
*.swp

# ==========================
# ⚙️ Build outputs
# ==========================
dist/
.next/
frontend/.next/
out/              # Next.js static export (if used)
coverage/         # test coverage
mobile/**/build/
mobile/android/**/build/
mobile/ios/**/build/

# ==========================
# 📦 Logs
# ==========================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================
# ☁️ Vercel deployment
# ==========================
.vercel/

# ==========================
# 🧰 Backups & archives
# ==========================
backups/
frontend/backups/
_artifacts/
_artifacts/**
*.zip
*.tar.gz
*.aab
*.apk
*.ipa
*.dSYM.zip

# ==========================
# 🔑 Sensitive folders
# ==========================
keys/
mobile/dist-dev/
mobile/dist-prod/
